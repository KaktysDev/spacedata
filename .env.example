# Server-only. Never prefix these with NEXT_PUBLIC_ and do not commit real keys.
# Copy to .env.local. Live chat calls Google Gemini.

# Preferred name.
GEMINI_API_KEY=
# Alias, used only when GEMINI_API_KEY is empty.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
