# Server-only. Never prefix any of these with NEXT_PUBLIC_. Never commit real values.
GEMINI_API_KEY=
# Optional alias when GEMINI_API_KEY is empty:
GOOGLE_GENERATIVE_AI_API_KEY=

# Required for live production requests on Vercel (shared, atomic abuse limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global maximum paid requests per UTC day across all users/providers (default 200).
CHAT_DAILY_LIMIT=200
# Optional canonical origin, e.g. https://your-app.vercel.app. No trailing slash.
APP_ORIGIN=

# Optional providers; Gemini alone is enough.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
