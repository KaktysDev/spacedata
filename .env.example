# Server-only. Never prefix these with NEXT_PUBLIC_ and do not commit real keys.
# Copy to .env.local. Live chat prefers xAI, then OpenAI.

# xAI / Grok. Used when set.
XAI_API_KEY=
# Optional. Defaults to grok-4.7.
XAI_MODEL=grok-4.7

# Fallback when XAI_API_KEY is empty.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
